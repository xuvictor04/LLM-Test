
# Generated tokenizer caches (dynamic tokenizer saves these per-run)
# OS / editor
# Python
# Training artifacts / checkpoints
*.ckpt
*.egg-info/
*.log
*.pt
*.py[cod]
*.swp
.DS_Store
.venv/
__pycache__/
bench_out/
data/dyntok.json
data/dyntok_*.json
data/tok_*.json
env/
runs/
# Fetched corpora. longrun.sh pilot writes data_pilot/ and run writes data_big/; without these a
# working tree is untracked-dirty the moment anyone runs a pilot.
data_pilot/
data_big/
data_grid/
# ...and any other corpus directory. data_075/ was created for the 0.75 GB run and was NOT covered by the
# three names above, so a 1 GB fetch made the tree untracked-dirty. The glob covers the next one too.
data_075/
data_[0-9]*/
venv/

# accidental checkpoint dirs from SAVE_CKPT=<falsy> (now normalised to OFF, kept so old trees stay clean)
/0/
source.bin
